Project mare_dashboard_production {
  database_type: 'PostgreSQL'
  Note: 'Production database schema for MARE Dashboard (Multi-Agent Research Environment)'
}

// -----------------------------------------------------------------------------
// USER & ACCESS MANAGEMENT (Multi-Tenant)
// -----------------------------------------------------------------------------
Table users {
  id uuid [primary key, default: `uuid_generate_v4()`]
  email varchar(255) [unique, not null]
  password_hash varchar(255)
  first_name varchar(100)
  last_name varchar(100)
  avatar_url varchar(255)
  is_active boolean [default: true]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  last_login_at timestamptz
}

Table organizations {
  id uuid [primary key, default: `uuid_generate_v4()`]
  name varchar(255) [not null]
  slug varchar(255) [unique, not null]
  billing_plan varchar(50) [default: 'free']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  deleted_at timestamptz [note: 'Soft delete']
}

Enum org_role {
  "owner"
  "admin"
  "member"
  "viewer"
}

Table organization_members {
  id uuid [primary key, default: `uuid_generate_v4()`]
  organization_id uuid [not null, ref: > organizations.id, note: 'Cascades on delete']
  user_id uuid [not null, ref: > users.id, note: 'Cascades on delete']
  role org_role [default: 'member']
  created_at timestamptz [default: `now()`]

  indexes {
    (organization_id, user_id) [unique]
  }
}

// -----------------------------------------------------------------------------
// CORE ENTITIES
// -----------------------------------------------------------------------------
Table projects {
  id uuid [primary key, default: `uuid_generate_v4()`]
  organization_id uuid [not null, ref: > organizations.id]
  created_by uuid [ref: > users.id]
  name varchar(255) [not null]
  description text
  goal text
  data_source varchar(255)
  priority varchar(50)
  settings jsonb [default: '{}', note: 'Project-specific configurations']
  is_archived boolean [default: false]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  deleted_at timestamptz [note: 'Soft delete']

  indexes {
    organization_id
  }
}

// -----------------------------------------------------------------------------
// AGENT MANAGEMENT & EXECUTION
// -----------------------------------------------------------------------------
Table agent_types {
  id int [primary key]
  name varchar(100) [unique, not null]
  description text
  default_prompt text
  capabilities jsonb [note: 'List of tools/capabilities this agent type supports']
}

Table agent_configs {
  id uuid [primary key, default: `uuid_generate_v4()`]
  project_id uuid [not null, ref: > projects.id]
  agent_type_id int [not null, ref: > agent_types.id]
  name varchar(255)
  system_prompt text
  llm_model varchar(100) [default: 'mistral-large-latest']
  temperature decimal [default: 0.7]
  settings jsonb [default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    (project_id, agent_type_id) [unique, note: 'One config per type per project, or remove unique if multiple allowed']
  }
}

Enum run_status {
  "pending"
  "running"
  "completed"
  "failed"
  "cancelled"
}

Table agent_runs {
  id uuid [primary key, default: `uuid_generate_v4()`]
  project_id uuid [not null, ref: > projects.id]
  agent_config_id uuid [not null, ref: > agent_configs.id]
  status run_status [default: 'pending']
  user_query text
  error_message text
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [default: `now()`]
  
  indexes {
    project_id
    agent_config_id
    status
  }
}

Table agent_messages {
  id uuid [primary key, default: `uuid_generate_v4()`]
  agent_run_id uuid [not null, ref: > agent_runs.id]
  role varchar(50) [not null, note: 'user, assistant, system, tool']
  content text [not null]
  tokens_used int
  created_at timestamptz [default: `now()`]

  indexes {
    agent_run_id
  }
}

// -----------------------------------------------------------------------------
// FILE SYSTEM (VIRTUAL DOM/CODEBASE)
// -----------------------------------------------------------------------------
Enum node_type {
  "file"
  "folder"
}

Table file_system_nodes {
  id uuid [primary key, default: `uuid_generate_v4()`]
  project_id uuid [not null, ref: > projects.id]
  parent_id uuid [ref: > file_system_nodes.id]
  name varchar(255) [not null]
  type node_type [not null]
  size_bytes bigint [default: 0]
  mime_type varchar(100)
  is_locked boolean [default: false]
  
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  deleted_at timestamptz [note: 'Soft delete']

  indexes {
    project_id
    parent_id
  }
}

Table node_contents {
  id uuid [primary key, default: `uuid_generate_v4()`]
  file_node_id uuid [not null, ref: > file_system_nodes.id]
  agent_config_id uuid [ref: > agent_configs.id, note: 'Which agent wrote this? Null if user']
  content text
  version int [default: 1]
  created_at timestamptz [default: `now()`]

  indexes {
    file_node_id
  }
}

// -----------------------------------------------------------------------------
// WORKFLOW / PIPELINE GRAPH
// -----------------------------------------------------------------------------
Table workflows {
  id uuid [primary key, default: `uuid_generate_v4()`]
  project_id uuid [not null, ref: > projects.id]
  name varchar(255) [not null]
  description text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table workflow_nodes {
  id uuid [primary key, default: `uuid_generate_v4()`]
  workflow_id uuid [not null, ref: > workflows.id]
  ui_node_id varchar(100) [not null]
  type varchar(100) [default: 'default']
  position_x float
  position_y float
  data jsonb [not null, default: '{}']
  
  created_at timestamptz [default: `now()`]
  
  indexes {
    workflow_id
  }
}

Table workflow_edges {
  id uuid [primary key, default: `uuid_generate_v4()`]
  workflow_id uuid [not null, ref: > workflows.id]
  ui_edge_id varchar(100) [not null]
  source_node_id varchar(100) [not null]
  target_node_id varchar(100) [not null]
  animated boolean [default: false]
  data jsonb [default: '{}']
  
  created_at timestamptz [default: `now()`]
  
  indexes {
    workflow_id
  }
}

// -----------------------------------------------------------------------------
// AUDIT & LOGGING
// -----------------------------------------------------------------------------
Table system_logs {
  id uuid [primary key, default: `uuid_generate_v4()`]
  project_id uuid [ref: > projects.id]
  agent_run_id uuid [ref: > agent_runs.id]
  log_level varchar(20) [default: 'INFO']
  message text [not null]
  metadata jsonb
  created_at timestamptz [default: `now()`]

  indexes {
    project_id
    created_at
  }
}
